# ====================================================================
# FarmConnect AI — Blockchain Workspace Environment Configuration
# Copy this file to blockchain/.env for public testnet deployments.
# NEVER commit private keys or mnemonic phrases!
# ====================================================================

# Local Hardhat (Default):
# Hardhat provides 20 pre-funded test accounts with well-known deterministic private keys.
# No .env is required when running locally against `npx hardhat node`.

# Public Testnet Configuration (e.g. Sepolia or Polygon Amoy):
TESTNET_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
DEPLOYER_PRIVATE_KEY=your_testnet_account_private_key_without_0x_prefix
ETHERSCAN_API_KEY=your_etherscan_or_polygonscan_api_key_for_verification
