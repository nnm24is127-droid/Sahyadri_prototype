{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "blockchain": {
      "root": "blockchain",
      "runtime": "container"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app/main.py",
      "bindings": [
        {
          "type": "service",
          "service": "blockchain",
          "format": "url",
          "env": "BLOCKCHAIN_RPC_URL"
        }
      ]
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
