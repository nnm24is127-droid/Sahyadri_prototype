# ====================================================================
# FarmConnect AI — Frontend Environment Configuration Template
# Copy this file to frontend/.env.local or frontend/.env for production
# ====================================================================

# Backend FastAPI Service Base URL
# For local development:
VITE_API_BASE_URL=http://localhost:8000/api/v1
# For production (e.g., Render / Fly.io / Railway):
# VITE_API_BASE_URL=https://farmconnect-backend.onrender.com/api/v1

# Blockchain EVM Network Settings
# Local Hardhat Node RPC (Chain ID 31337) or Public Testnet (e.g. Sepolia / Polygon Amoy)
VITE_BLOCKCHAIN_RPC_URL=http://localhost:8545
VITE_CHAIN_ID=31337

# Enable graceful client-side fallbacks when backend services are offline
VITE_ENABLE_MOCK_FALLBACKS=true
