# ====================================================================
# FarmConnect AI — Backend Environment Configuration Template
# Copy to .env in backend/ directory.
# NEVER commit production secrets or real private keys to git!
# ====================================================================

ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="FarmConnect AI"
VERSION="1.0.0"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database Settings (PostgreSQL / Supabase / SQLite) ---
# Default for rapid local development & tests:
DATABASE_URL=sqlite:///./farmconnect.db
# For production Supabase / PostgreSQL instance:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- CORS Settings ---
# In production, replace '*' with your deployed frontend URL (e.g., https://farmconnect-ai.vercel.app)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","https://farmconnect-ai.vercel.app"]

# --- External Services & AI (Anthropic Claude) ---
# When ANTHROPIC_API_KEY is not set or rate-limited, system operates in high-fidelity rule-based fallback
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_TOKENS=1024
SPEECH_SERVICE_PROVIDER=bhashini_browser_hybrid

# --- Blockchain & Smart Contract Settings ---
# Local Hardhat EVM (Chain ID 31337) or Public Testnet (e.g. Sepolia Chain ID 11155111, Polygon Amoy Chain ID 80002)
# NOTE: Do NOT use local Hardhat addresses as if they were public testnet addresses!
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Deployed Contract Addresses on the active network:
# (Populated by running deploy scripts in blockchain/ folder)
AGREEMENT_REGISTRY_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
ORDER_REGISTRY_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
TRACEABILITY_CONTRACT_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
ESCROW_CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
TEST_FARM_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Automated relayer/backend signer private key (Hardhat Account #0 default for local testing)
BACKEND_SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
