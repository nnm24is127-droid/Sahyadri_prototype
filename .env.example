# ====================================================================
# FarmConnect AI — Environment Configuration Template
# Copy this file to .env in backend/ and frontend/ as needed.
# Do NOT put production secrets in version control.
# ====================================================================

# --- General & App Settings ---
ENVIRONMENT=development
DEBUG=True
APP_NAME="FarmConnect AI"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database Settings (PostgreSQL / Supabase) ---
# Default for rapid local development & tests: SQLite file or PostgreSQL URI
DATABASE_URL=sqlite:///./farmconnect.db
# Example for Supabase:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- AI Integration (Anthropic Claude API) ---
# If left empty, system operates in high-fidelity mock/rule-based fallback mode
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_TOKENS=1024
SPEECH_SERVICE_PROVIDER=browser_web_speech_api

# --- Blockchain & Web3 Settings ---
# Local Hardhat Node RPC URL
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Deployed contract addresses (populated after deployment)
AGREEMENT_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
TRACEABILITY_CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
TEST_FARM_TOKEN_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
ESCROW_CONTRACT_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
# Optional backend signer private key for automated anchoring
BACKEND_SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Frontend Client Settings (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_BLOCKCHAIN_RPC_URL=http://localhost:8545
VITE_CHAIN_ID=31337
VITE_ENABLE_MOCK_FALLBACKS=true
